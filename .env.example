# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_PRO_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
TAVILY_API_KEY=your_tavily_api_key

# Mercado Pago — developers.mercadopago.com
# El checkout usa la pagina alojada de MP (init_point), asi que no hace falta la public key del browser.
MP_ACCESS_TOKEN=your_mp_access_token
MP_WEBHOOK_SECRET=your_mp_webhook_signing_secret

# Site / redirects (use your real domain in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
